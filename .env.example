# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB v3 API key (not the API Read Access Token): live film/TV/person metadata and posters
VITE_TMDB_API_KEY="YOUR_TMDB_API_KEY"

# VITE_CARTO_API_KEY: For Carto Basemaps romantic tiles
VITE_CARTO_API_KEY="YOUR_CARTO_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Maps JavaScript/tiles; restrict by domain and API.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Supabase browser credentials (publishable/anon key only; never put service_role here)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
